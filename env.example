# Copy to .env and fill in. Never commit .env.

# Circle API key for the on-ramp backend (server only, never expose in the browser).
# Create a testnet key at https://console.circle.com/app-kits/onramp
CIRCLE_API_KEY=

# Circle Onramp test mode (no real money). Keep these three together.
ONRAMP_API_BASE_URL=https://api-test.circle.com
VITE_ONRAMP_WIDGET_BASE_URL=https://onramp-sandbox.arc.io
ONRAMP_REFERRER_DOMAIN=localhost

# Optional: port of the on-ramp backend (default 8787)
# PORT=8787
